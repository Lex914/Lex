-- ── Services ──────────────────────────────────────────────────
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local UserInputService  = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser       = game:GetService("VirtualUser")
local StarterGui        = game:GetService("StarterGui")

local lp   = Players.LocalPlayer
local pg   = lp.PlayerGui
local char = lp.Character or lp.CharacterAdded:Wait()
local hum  = char:WaitForChild("Humanoid")
local hrp  = char:WaitForChild("HumanoidRootPart")

-- ── Config ────────────────────────────────────────────────────
local CFG = {
    AutoTap        = false,
    AutoFarm       = false,
    AutoRebirth    = false,
    AutoUpgrade    = false,
    AutoHatch      = false,
    InfSpeed       = false,
    InfJump        = false,
    AntiAFK        = true,
    CoinESP        = false,
    AntiDetect     = true,
    TapDelay       = 0,
    SpeedVal       = 100,
    JumpVal        = 150,
    HatchCount     = 8,
    RebirthAt      = 500,
    TapThreads     = 12,
    MenuKey        = Enum.KeyCode.RightShift,
}

-- ── Utility ───────────────────────────────────────────────────
local function notify(txt)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = "⬡ Genhub",
            Text     = txt,
            Duration = 2,
        })
    end)
end

local function safe(fn, ...)
    pcall(fn, ...)
end

local function rdelay()
    if CFG.AntiDetect then
        task.wait(math.random(1, 4) * 0.001)
    end
end

local function findRemote(...)
    local names = {...}
    local function search(parent)
        if not parent then return nil end
        for _, n in pairs(names) do
            local r = parent:FindFirstChild(n, true)
            if r then return r end
        end
    end
    return search(ReplicatedStorage) or search(workspace)
end

local function getLeaderstat(...)
    for _, name in pairs({...}) do
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            local v = ls:FindFirstChild(name)
            if v then return tonumber(v.Value) or 0 end
        end
        for _, obj in pairs(lp:GetChildren()) do
            local v = obj:FindFirstChild(name)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                return tonumber(v.Value) or 0
            end
        end
    end
    return 0
end

local function getCoins()
    return getLeaderstat("Coins","Cash","Taps","Gems","Points","Tokens","Score")
end

local function getRebirths()
    return getLeaderstat("Rebirths","Prestige","Reborn","Stages","Rebirth")
end

-- ── Character refresh ─────────────────────────────────────────
lp.CharacterAdded:Connect(function(c)
    char = c
    hum  = c:WaitForChild("Humanoid")
    hrp  = c:WaitForChild("HumanoidRootPart")
end)

-- ── Loop manager ──────────────────────────────────────────────
local loops = {}

local function startLoop(name, fn, delay)
    if loops[name] then return end
    loops[name] = true
    task.spawn(function()
        while loops[name] and CFG[name] do
            safe(fn)
            task.wait(delay or 0)
        end
        loops[name] = nil
    end)
end

local function stopLoop(name)
    loops[name] = nil
end

-- ── Remotes ───────────────────────────────────────────────────
local tapRemote     = findRemote("Tap","TapEvent","OnTap","Click","TapBrick","TouchTap","TapRemote","TapAction")
local rebirthRemote = findRemote("Rebirth","Prestige","RebirthEvent","DoRebirth","RebirthRemote","ReBirth")
local upgradeRemote = findRemote("BuyUpgrade","Upgrade","Purchase","BuyItem","UpgradeRemote","UpgradeItem")
local hatchRemote   = findRemote("Hatch","HatchEgg","BuyEgg","OpenEgg","EggHatch","HatchRemote","HatchPet")

-- ── 1. MEGA TAP ───────────────────────────────────────────────
local tapThreadHandles = {}

local function fireTap()
    rdelay()
    -- Remote fire
    if tapRemote then
        if tapRemote:IsA("RemoteEvent") then
            tapRemote:FireServer()
        elseif tapRemote:IsA("RemoteFunction") then
            pcall(function() tapRemote:InvokeServer() end)
        end
    end
    -- ReplicatedStorage tüm remote tara
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("tap") or n:find("click") or n:find("hit")
            or n:find("touch") or n:find("earn") or n:find("collect") then
                safe(function() obj:FireServer() end)
            end
        end
        if obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            if n:find("tap") or n:find("click") then
                safe(function() obj:InvokeServer() end)
            end
        end
    end
    -- ClickDetector + ProximityPrompt
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            safe(fireClickDetector, obj)
        end
        if obj:IsA("ProximityPrompt") then
            safe(fireproximityprompt, obj)
        end
    end
    -- UI butonlar
    for _, btn in pairs(pg:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local n = btn.Name:lower()
            if n:find("tap") or n:find("click") or n:find("hit") then
                safe(function() btn.MouseButton1Click:Fire() end)
            end
        end
    end
end

local function startMegaTap()
    for i = 1, CFG.TapThreads do
        task.spawn(function()
            while CFG.AutoTap do
                fireTap()
                task.wait(CFG.TapDelay)
            end
        end)
    end
end

-- ── 2. AUTO FARM ──────────────────────────────────────────────
local function getBestArea()
    local names = {"Areas","Zones","Worlds","Islands","Map","Stages","Regions","Locations"}
    for _, n in pairs(names) do
        local c = workspace:FindFirstChild(n)
        if c then
            local best, bestN = nil, -1
            for _, a in pairs(c:GetChildren()) do
                local num = tonumber(a.Name:match("%d+")) or 0
                if num > bestN then bestN = num; best = a end
            end
            if best then return best end
        end
    end
end

local function doFarm()
    local area = getBestArea()
    if area and hrp then
        local part = area:FindFirstChildWhichIsA("BasePart")
        if part then
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 5, 0))
        end
    end
    fireTap()
end

-- ── 3. AUTO REBIRTH ───────────────────────────────────────────
local function doRebirth()
    if getCoins() < CFG.RebirthAt then return end
    rdelay()
    if rebirthRemote then
        if rebirthRemote:IsA("RemoteEvent") then
            rebirthRemote:FireServer()
        else
            pcall(function() rebirthRemote:InvokeServer() end)
        end
    end
    for _, btn in pairs(pg:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local n = btn.Name:lower()
            if n:find("rebirth") or n:find("prestige") or n:find("reborn") then
                safe(function() btn.MouseButton1Click:Fire() end)
            end
        end
    end
    notify("🔁 Rebirth! x" .. tostring(getRebirths()))
end

-- ── 4. AUTO UPGRADE ───────────────────────────────────────────
local function doUpgrade()
    rdelay()
    if upgradeRemote then
        for i = 1, 30 do
            safe(function()
                if upgradeRemote:IsA("RemoteEvent") then
                    upgradeRemote:FireServer(i)
                else
                    upgradeRemote:InvokeServer(i)
                end
            end)
        end
    end
    for _, btn in pairs(pg:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local n = btn.Name:lower()
            if n:find("buy") or n:find("upgrade") or n:find("max") or n:find("purchase") then
                safe(function() btn.MouseButton1Click:Fire() end)
            end
        end
    end
end

-- ── 5. AUTO HATCH x8 ──────────────────────────────────────────
local function getBestEgg()
    local best, bestN = nil, -1
    for _, obj in pairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") then
            local num = tonumber(obj.Name:match("%d+")) or 0
            if num > bestN then bestN = num; best = obj end
        end
    end
    -- GUI'den de dene
    for _, obj in pairs(pg:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") then
            local num = tonumber(obj.Name:match("%d+")) or 0
            if num > bestN then bestN = num end
        end
    end
    return best
end

local function doHatch()
    local egg     = getBestEgg()
    local eggName = egg and egg.Name or "Best"
    rdelay()

    for i = 1, CFG.HatchCount do
        -- Remote
        if hatchRemote then
            safe(function()
                if hatchRemote:IsA("RemoteEvent") then
                    hatchRemote:FireServer(eggName, 1)
                else
                    hatchRemote:InvokeServer(eggName, 1)
                end
            end)
        end
        -- Tüm hatch remoteları tara
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                if n:find("hatch") or n:find("egg") or n:find("open") or n:find("pet") then
                    safe(function() obj:FireServer(eggName, 1) end)
                end
            end
        end
        -- Egg üzerindeki detector
        if egg then
            for _, d in pairs(egg:GetDescendants()) do
                if d:IsA("ClickDetector") then safe(fireClickDetector, d) end
                if d:IsA("ProximityPrompt") then safe(fireproximityprompt, d) end
            end
        end
        -- UI hatch buton
        for _, btn in pairs(pg:GetDescendants()) do
            if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                local n = btn.Name:lower()
                if n:find("hatch") or n:find("open") or n:find("x8") or n:find("x10") or n:find("buy") then
                    safe(function() btn.MouseButton1Click:Fire() end)
                end
            end
        end
        task.wait(0.02)
    end
end

-- ── 6. INF SPEED / JUMP ───────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not hum then return end
    if CFG.InfSpeed then hum.WalkSpeed = CFG.SpeedVal end
    if CFG.InfJump  then hum.JumpPower = CFG.JumpVal  end
end)

-- ── 7. ANTI AFK ───────────────────────────────────────────────
lp.Idled:Connect(function()
    if not CFG.AntiAFK then return end
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(0.1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- ── 8. COIN / GEM ESP ─────────────────────────────────────────
local espBoards = {}

local function clearESP()
    for _, b in pairs(espBoards) do pcall(function() b:Destroy() end) end
    espBoards = {}
end

local function addESP(part, label)
    if not part or not part.Parent then return end
    local bb = Instance.new("BillboardGui")
    bb.Size          = UDim2.new(0, 90, 0, 28)
    bb.AlwaysOnTop   = true
    bb.StudsOffset   = Vector3.new(0, 3, 0)
    bb.Adornee       = part
    bb.Parent        = part

    local lbl = Instance.new("TextLabel")
    lbl.Size                 = UDim2.new(1,0,1,0)
    lbl.BackgroundColor3     = Color3.fromRGB(0,0,0)
    lbl.BackgroundTransparency = 0.35
    lbl.TextColor3           = Color3.fromRGB(255,215,0)
    lbl.Text                 = "💰 " .. label
    lbl.TextScaled           = true
    lbl.Font                 = Enum.Font.GothamBold
    lbl.Parent               = bb
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0,4)
    table.insert(espBoards, bb)
end

local function refreshESP()
    clearESP()
    if not CFG.CoinESP then return end
    for _, obj in pairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("coin") or n:find("gem") or n:find("drop")
        or n:find("reward") or n:find("pickup") or n:find("cash") then
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if part then addESP(part, obj.Name) end
        end
    end
end

task.spawn(function()
    while task.wait(3) do
        if CFG.CoinESP then refreshESP() end
    end
end)

-- ── Toggle ────────────────────────────────────────────────────
local function toggle(key, loopFn, delay)
    CFG[key] = not CFG[key]
    if key == "AutoTap" then
        if CFG[key] then startMegaTap() end
    elseif loopFn then
        if CFG[key] then startLoop(key, loopFn, delay) else stopLoop(key) end
    end
    if key == "CoinESP" then
        if CFG[key] then refreshESP() else clearESP() end
    end
    return CFG[key]
end

